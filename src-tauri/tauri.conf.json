{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "Litube",
  "version": "0.1.0",
  "identifier": "com.litube.desktop",
  "build": {
    "frontendDist": "../ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Litube",
        "width": 1100,
        "height": 700,
        "resizable": true,
        "fullscreen": false,
        "transparent": true,
        "decorations": true,
        "visible": true,
        "focus": true
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' ipc: tauri:; img-src 'self' data: https:;"
    }
  }
}

